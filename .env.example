# ==============================================================================
# ChickCheck Environment Configuration
# ==============================================================================

# Livestock Species Configuration
# Supported values: chicken | duck | cow | sheep | goat | comma-separated (e.g. chicken,duck) | all
SPECIES=chicken

# Adaptive Low-Resolution & Dense Crowd Adaptations
ENHANCE_LOW_RES=true
LOW_RES_MAX_DIM=540
CLAHE_CLIP_LIMIT=2.5
SHARPEN_FACTOR=0.4
DENSE_CROWD_MODE=true

# Video Stream Configuration
# Default: Local looping MP4 file. For live network cameras, use rtsp:// or http://
VIDEO_SOURCE=samples/dummy.mp4

# Vision & Detection Engine
# Base weights (auto-download). yolo11n is too weak for chicks. CPU: yolo11m. GPU: yolo11x + INFER_IMGSZ=1280.
MODEL_WEIGHTS=yolo11m.pt
# Path to fine-tuned weights (optional)
# CUSTOM_WEIGHTS_PATH=/path/to/custom_chicken_yolo11.pt
# Custom class names if using fine-tuned model (comma-separated, optional)
# CUSTOM_CLASS_NAMES=chicken,rooster,hen
# Optional classifier weights for sick/healthy animal crops
# HEALTH_CLASSIFIER_PATH=/path/to/classifier.pt

# Processing & Hardware
PROCESS_EVERY_N=2
INFER_IMGSZ=640
CONF_THRESHOLD=0.25
# Adaptive scaling may lower CONF_THRESHOLD for poultry/low-res, but never below this floor
ADAPTIVE_CONF_SCALING=true
ADAPTIVE_CONF_FLOOR=0.10
# Extra COCO classes stock models use for top-down chicks (poultry only)
POULTRY_PROXY_CLASSES=sheep,teddy bear
# Experimental colour-blob detector for missed chicks (needs >=3 YOLO boxes per frame)
POULTRY_COLOR_FUSION=false
TRACK_LOST_SECONDS=2.0
MAX_TRAIL_POINTS=30
# Auto-detects 'cuda' if GPU available, otherwise 'cpu'
# DEVICE=cpu

# Database Storage
# Default: Local SQLite database with WAL mode enabled.
# For Docker PostgreSQL: postgresql://chickcheck:chickcheck_secret@postgres:5432/chickcheck
DATABASE_URL=sqlite:///./data/chickcheck.db

# File Storage & Retention
DATA_DIR=./data
SNAPSHOTS_DIR=./data/snapshots
CLIPS_DIR=./data/clips
REPORTS_DIR=./data/reports
RETENTION_DAYS=7
DAILY_REPORT_HOUR=8

# Anomaly Sensitivity & Quiet Hours
# Sensitivity preset: low | normal | high
SENSITIVITY=normal
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22
QUIET_HOURS_END=6

# Telegram Bot Notification Channel
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook Notification Channel
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# SMTP Email Notification Channel
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@farm.local
SMTP_TO=owner@farm.local
SMTP_TLS=true


# Web Push notifications (installed PWA / browser). Generate keys with:
#   .venv/bin/python scripts/generate_vapid_keys.py
# Keep VAPID_PRIVATE_KEY secret — backend only, never in frontend code.
WEBPUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@farm.local
